{
  "name": "hrmy-translate",
  "private": true,
  "description": "호리씨와 미야무라군 번역 제공. 비공식.",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc",
    "test": "prettier --check \"**/*.{js,ts,tsx,json,scss}\"",
    "fix": "prettier --write \"**/*.{js,ts,tsx,json,scss}\"",
    "zip": "npm run build && cd extension && zip -qr ../extension.zip ."
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.2",
    "marked": "^18.0.13",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.104.1",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "singleQuote": true
  }
}
